<!-- Plugin Configuration File. Read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>cn.codecrab.plugins.dsh</id>
    <name>Dsh Dock</name>
    <vendor email="codecrab.cn@gmail.com" url="https://github.com/Coco-king/dsh-dock">codecrab</vendor>

    <!-- 仅依赖平台模块 (外加可选的内嵌浏览器模块), 可在所有 JetBrains IDE 中安装 -->
    <depends>com.intellij.modules.platform</depends>

    <!-- 内嵌浏览器 (JCEF): 2026.2 起 JCEF 从平台核心拆分为独立模块, 未声明该依赖的插件
         拿不到 com.intellij.ui.jcef.* (启动即报 NoClassDefFoundError)。
         该依赖别名自 2025.3.1 起才提供, 且 JCEF 在部分环境本就不可用 —— 故声明为可选:
         存在时把 JCEF 纳入插件类路径; 不存在时插件照常加载, 由系统浏览器兜底 -->
    <depends optional="true">com.intellij.modules.jcef</depends>

    <resource-bundle>messages.DshBundle</resource-bundle>

    <extensions defaultExtensionNs="com.intellij">
        <applicationService serviceImplementation="cn.codecrab.plugins.dsh.settings.DshSettingsState"/>
        <notificationGroup id="Dsh" displayType="BALLOON"/>
        <toolWindow
            id="Dsh Dock"
            anchor="right"
            icon="/icons/dshWhaleBlack.svg"
            factoryClass="cn.codecrab.plugins.dsh.toolwindow.DshToolWindowFactory"/>
        <applicationConfigurable
            id="cn.codecrab.plugins.dsh.settings"
            parentId="other"
            displayName="Dsh Dock"
            instance="cn.codecrab.plugins.dsh.settings.DshSettingsConfigurable"/>
        <!-- 项目级后台活动: 「IDEA 启动时自动启动 dsh」(设置开启时, 本次会话首次打开项目即在后台预热 dsh)。
             平台推荐的项目打开回调 (ProjectManagerListener.projectOpened 已废弃并计划移除) -->
        <backgroundPostStartupActivity implementation="cn.codecrab.plugins.dsh.server.DshIdeStartupActivity"/>
    </extensions>

    <!-- action 的 id 与 text/description 资源 key 是稳定标识 (与类所在包无关):
         改 id 会丢失用户已绑定的快捷键, 改 key 需同步 properties 文件, 重构移动类时保持不变 -->
    <actions>
        <action
            id="cn.codecrab.plugins.dsh.OpenDshToolWindowAction"
            class="cn.codecrab.plugins.dsh.actions.OpenDshToolWindowAction"
            text="cn.codecrab.plugins.dsh.OpenDshToolWindowAction.action.text"
            description="cn.codecrab.plugins.dsh.OpenDshToolWindowAction.action.description">
            <add-to-group group-id="ToolsMenu" anchor="last"/>
        </action>

        <!-- 编辑器右键菜单组: Dsh 相关操作集中在一组, 与其他菜单项分隔显示 -->
        <group id="cn.codecrab.plugins.dsh.EditorContextMenuGroup" popup="false">
            <add-to-group group-id="EditorPopupMenu" anchor="first"/>

            <!-- 编辑器右键: 发送选中代码的行范围引用到 Dsh 输入框 -->
            <action
                id="cn.codecrab.plugins.dsh.SendSelectionToDshAction"
                class="cn.codecrab.plugins.dsh.actions.SendSelectionToDshAction"
                text="cn.codecrab.plugins.dsh.SendSelectionToDshAction.action.text"
                description="cn.codecrab.plugins.dsh.SendSelectionToDshAction.action.description"/>

            <!-- 编辑器右键: 复制选中代码的行范围引用到剪贴板 -->
            <action
                id="cn.codecrab.plugins.dsh.CopySelectionReferenceAction"
                class="cn.codecrab.plugins.dsh.actions.CopySelectionReferenceAction"
                text="cn.codecrab.plugins.dsh.CopySelectionReferenceAction.action.text"
                description="cn.codecrab.plugins.dsh.CopySelectionReferenceAction.action.description"/>

            <!-- 分隔线: 与本菜单其他项隔开 -->
            <separator/>
        </group>

        <!-- 项目视图右键菜单组: Dsh 相关操作集中在一组, 与其他菜单项分隔显示 -->
        <group id="cn.codecrab.plugins.dsh.ProjectContextMenuGroup" popup="false">
            <add-to-group group-id="ProjectViewPopupMenu" anchor="first"/>

            <!-- 项目视图右键: 发送文件路径引用到 Dsh 输入框 -->
            <action
                id="cn.codecrab.plugins.dsh.SendFileToDshAction"
                class="cn.codecrab.plugins.dsh.actions.SendFileToDshAction"
                text="cn.codecrab.plugins.dsh.SendFileToDshAction.action.text"
                description="cn.codecrab.plugins.dsh.SendFileToDshAction.action.description"/>

            <!-- 项目视图右键: 复制文件路径引用到剪贴板 -->
            <action
                id="cn.codecrab.plugins.dsh.CopyFileReferenceAction"
                class="cn.codecrab.plugins.dsh.actions.CopyFileReferenceAction"
                text="cn.codecrab.plugins.dsh.CopyFileReferenceAction.action.text"
                description="cn.codecrab.plugins.dsh.CopyFileReferenceAction.action.description"/>

            <!-- 分隔线: 与本菜单其他项隔开 -->
            <separator/>
        </group>
    </actions>
</idea-plugin>
